# ============================================================
#  Copia este archivo a  .env  y rellena tus valores.
#  NUNCA subas el .env a git ni se lo pases a nadie.
# ============================================================

# --- Credenciales de Bybit ------------------------------------------------
# Crea la API key en https://testnet.bybit.com  (menú API -> Create New Key).
# Permisos: "Read-Write" -> "Spot Trading". NADA de Withdraw.
BYBIT_API_KEY=pon_aqui_tu_api_key
BYBIT_API_SECRET=pon_aqui_tu_api_secret

# true  = testnet (dinero ficticio, RECOMENDADO para empezar)
# false = mainnet (DINERO REAL). No lo cambies hasta confiar en el bot.
BYBIT_TESTNET=true

# --- Motor de decisión (Claude Code CLI) ----------------------------------
# Ruta al ejecutable de Claude Code. Normalmente basta con "claude".
# Si no está en el PATH, pon la ruta completa, por ejemplo:
#   C:\Users\Javi\AppData\Roaming\npm\claude.cmd
CLAUDE_BIN=claude

# Modelo para las decisiones (vacío = el que tengas por defecto).
CLAUDE_MODEL=

# Segundos máximos de espera por una decisión (si se agota -> HOLD seguro).
CLAUDE_TIMEOUT=120

# Argumentos extra para el CLI, separados por espacios (normalmente vacío).
CLAUDE_EXTRA_ARGS=

# --- Servidor / dashboard -------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# Clave para proteger la API local (el dashboard la pide al entrar).
# Cámbiala por una cadena larga y aleatoria.
API_TOKEN=cambia-esto-por-una-cadena-larga-y-secreta
